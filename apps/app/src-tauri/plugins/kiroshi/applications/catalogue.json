[
	{
		"name": "superset",
		"title": "Superset",
		"description": "Run workspaces, terminals, agents and tasks.",
		"config": {
			"type": "http",
			"url": "https://api.superset.sh/mcp",
			"headers": { "Authorization": "Bearer ${SUPERSET_API_KEY}" }
		},
		"tools": [
			"projects_list",
			"hosts_list",
			"workspaces_list",
			"workspaces_create",
			"workspaces_update",
			"workspaces_delete",
			"terminals_list",
			"terminals_create",
			"terminals_read",
			"terminals_send",
			"terminals_close",
			"agents_list",
			"agents_create",
			"tasks_list",
			"tasks_get",
			"tasks_create",
			"tasks_update",
			"tasks_delete",
			"tasks_statuses_list"
		],
		"logo": "applications/logos/superset.svg",
		"install": {
			"kind": "key",
			"fields": [
				{
					"name": "Authorization",
					"secret": "SUPERSET_API_KEY",
					"description": "A Superset API key."
				}
			]
		}
	},
	{
		"name": "paper",
		"title": "Paper",
		"description": "Read and write designs in the Paper desktop app.",
		"config": { "type": "http", "url": "http://127.0.0.1:29979/mcp" },
		"tools": [
			"get_basic_info",
			"get_selection",
			"get_tree_summary",
			"get_children",
			"get_node_info",
			"find_nodes",
			"get_screenshot",
			"get_jsx",
			"get_computed_styles",
			"get_font_family_info",
			"get_guide",
			"write_html",
			"create_artboard",
			"duplicate_nodes",
			"update_styles",
			"set_text_content",
			"rename_nodes",
			"move_nodes",
			"delete_nodes",
			"finish_working_on_nodes"
		],
		"logo": "applications/logos/paper.svg",
		"install": { "kind": "nothing" }
	}
]

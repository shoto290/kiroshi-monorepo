{
	"name": "kiroshi",
	"private": true,
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shoto290/kiroshi-monorepo.git"
	},
	"workspaces": [
		"packages/*",
		"apps/*",
		"apps/app/sidecar"
	],
	"packageManager": "bun@1.3.13",
	"scripts": {
		"dev": "turbo run dev",
		"storybook": "turbo run storybook",
		"build": "turbo run build",
		"build:website": "turbo run build --filter=website",
		"tauri:build": "turbo run tauri:build",
		"test": "turbo run test",
		"baseline": "bun scripts/baseline.ts",
		"test:baseline": "bun test scripts/baseline.test.ts",
		"baseline:update": "bun scripts/baseline.ts --update",
		"baseline:prune": "bun scripts/baseline.ts --prune",
		"snapshots": "bun apps/app/sidecar/scripts/generate.ts && UPDATE_SNAPSHOTS=1 bun test --cwd apps/app/sidecar src/contracts.test.ts && UPDATE_SNAPSHOTS=1 cargo test --manifest-path apps/app/src-tauri/Cargo.toml --features fake-claude --test contracts",
		"lint": "turbo run lint",
		"lint:fix": "turbo run lint:fix",
		"types": "turbo run types",
		"format": "biome format",
		"ci": "bun run format && bun run lint && bun run types && bun run --filter=website build && bun run test",
		"release": "bun scripts/release.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@biomejs/biome": "2.5.8",
		"@rolldown/plugin-babel": "^0.2.3",
		"@types/babel__core": "^7.20.5",
		"@types/bun": "^1.3.14",
		"babel-plugin-react-compiler": "^1.0.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"turbo": "^2.9.6",
		"typescript": "^6.0.3"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,json,css,md}": "biome check --write --no-errors-on-unmatched"
	}
}
